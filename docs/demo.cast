[4.811021, "o", "\r\n\u001b[1;36m=== 3. Add a dependency (dry-run first) ===\u001b[0m\r\n"]
[5.411969, "o", "\u001b[1;33m$ /home/amine/GitHub/sticks/target/release/sticks add --dry-run fmt@10.2.1\u001b[0m\r\n"]
[5.413296, "o", "--- a//tmp/tmp.EP3Y7f0x1h/demo/CMakeLists.txt\r\n+++ b//tmp/tmp.EP3Y7f0x1h/demo/CMakeLists.txt\r\n@@ -1,5 +1,6 @@\r\n cmake_minimum_required(VERSION 3.21)\r\n project(demo CXX)\r\n+find_package(fmt 10.2.1 REQUIRED)\r\n \r\n set(CMAKE_CXX_STANDARD 17)\r\n set(CMAKE_CXX_STANDARD_REQUIRED ON)\r\n@@ -11,6 +12,8 @@\r\n file(GLOB_RECURSE SOURCES CONFIGURE_DEPENDS \"src/*.cpp\" \"src/*.cc\" \"src/*.cxx\" \"src/*.c++\" \"src/*.C\" \"src/*.CPP\" \"src/*.CC\" \"src/*.CXX\")\r\n \r\n add_executable(${PROJECT_NAME} ${SOURCES})\r\n+\r\n+target_link_libraries(${PROJECT_NAME} fmt::fmt)\r\n target_include_directories(${PROJECT_NAME} PRIVATE \"${CMAKE_CURRENT_SOURCE_DIR}/include\")\r\n \r\n # Optional: Installation\r\n✓ Added dependencies to CMakeLists.txt: [\"fmt@10.2.1\"]\r\n"]
